{
  "logo": {
    "source": "~/pictures/fast1.png",
    "type": "kitty",
    "width": 23,
    "height": 10,
    "padding": { "top": 1 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "bright_magenta", "title": "bright_cyan", "output": "bright_white" }
  },
  "modules": [
    { "type": "title", "format": "꩜ {user-name} ◌ {host-name} ꩜" },
    { "type": "custom", "format": "  ╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌" },
    { "type": "os",       "key": " ◈ os      " },
    { "type": "kernel",   "key": " ◈ kernel  " },
    { "type": "uptime",   "key": " ◈ uptime  " },
    { "type": "packages", "key": " ◈ pkgs    " },
    { "type": "shell",    "key": " ◈ shell   " },
    { "type": "wm",       "key": " ◈ wm      " },
    { "type": "terminal", "key": " ◈ term    " },
    { "type": "disk",     "key": " ◈ disk    " },
    { "type": "custom", "format": "  ╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌" },
    { "type": "custom", "format": "  ░▒ ♡ ✿ ◌ ❀ ✦ ◈ ❁ ▒░" }
  ]
}
