# hyprlang noerror false
# Put general config stuff here
# Here's a list of every variable: https://wiki.hyprland.org/Configuring/Variables/

# monitor=,addreserved, 0, 0, 0, 0 # Custom reserved area

# HDMI port: mirror display. To see device name, use `hyprctl monitors`

misc {
    vfr = true
    vrr = 1
    
}

decoration {
    rounding = 10
    
    blur {
        enabled = true
        size = 10
        passes = 6
        new_optimizations = true
        xray = false
        noise = 0.01
        contrast = 0.8
        brightness = 10
        popups = true
    }

    shadow {
        enabled = true
        range = 20
        render_power = 3
        color = rgba(ffb3d966)
    }
}

#indows transparency
windowrule = opacity 0.9 0.7, match:class ^(.*)$

#coloured border
general {
    border_size = 10
    col.active_border = rgba(ff79c6ff) rgba(ffb86cff) rgba(f1fa8cff) rgba(50fa7bff) rgba(8be9fdff) rgba(bd93f9ff) rgba(ff79c6ff) 45deg
    col.inactive_border = rgba(ff79c688) rgba(ffb86c88) rgba(f1fa8c88) rgba(50fa7b88) rgba(8be9fd88) rgba(bd93f988) rgba(ff79c688) 45deg
}

animations {
    enabled = true
    animation = borderangle, 1, 30, linear, loop
}

#mouse tweaks
input {
    sensitivity = -0.7
    
}
